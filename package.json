{
  "name": "finllm",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted personal finance platform with MCP for LLM agents",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm --parallel -r --filter @finllm/api --filter @finllm/web run dev",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @finllm/db run build && pnpm --filter @finllm/money run build && pnpm --filter @finllm/domain run build && pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:generate": "pnpm --filter @finllm/db run generate",
    "db:migrate": "pnpm --filter @finllm/db run migrate",
    "db:studio": "pnpm --filter @finllm/db run studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
