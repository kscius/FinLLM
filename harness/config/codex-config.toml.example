# Example fragment for OpenAI Codex CLI / compatible harnesses.
# Merge into your user or project Codex config; field names may vary by version.

[mcp_servers.finllm]
command = "node"
args = ["/ABSOLUTE/PATH/TO/FinLLM/apps/mcp/dist/index.js"]

[mcp_servers.finllm.env]
MCP_API_URL = "http://localhost:3001"
FINLLM_MCP_TOKEN = "REPLACE_WITH_TOKEN_FROM_API"
