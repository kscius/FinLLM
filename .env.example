# Database (host uses localhost; Docker Compose overrides hostname to postgres)
DATABASE_URL=postgresql://finllm:finllm@localhost:5432/finllm
POSTGRES_USER=finllm
POSTGRES_PASSWORD=finllm
POSTGRES_DB=finllm
POSTGRES_PORT=5432

# API (bind 0.0.0.0 for Docker/Render)
API_HOST=0.0.0.0
API_PORT=3001
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGIN=http://localhost:5173

# Web (Vite)
VITE_API_URL=http://localhost:3001

# MCP (stdio default; optional HTTP)
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3002
MCP_API_URL=http://localhost:3001
FINLLM_MCP_TOKEN=
MCP_HTTP_HOST=0.0.0.0
NODE_ENV=development

# Instance
FINLLM_TIMEZONE=America/Mexico_City
FINLLM_BOOK_CURRENCY=MXN
ALLOW_REGISTRATION=false

# Optional external AI (disabled by default)
AI_FEATURES_ENABLED=false
